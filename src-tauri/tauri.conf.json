{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EXIF Viewer",
  "version": "0.1.0",
  "identifier": "com.local.exifapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EXIF ビューア",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "EXIF Viewer",
    "copyright": "Copyright (c) 2026 EXIF Viewer contributors",
    "shortDescription": "画像・動画のメタデータ (EXIF) ビューア / エディタ"
  },
  "mainBinaryName": "exif-app"
}
