{
  "name": "exif-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "fetch-exiftool": "node scripts/fetch-exiftool.mjs",
    "build:exe": "npm run prepare-assets && tauri build --no-bundle",
    "app:dev": "npm run prepare-assets && tauri dev",
    "test": "vitest run",
    "prepare-assets": "node scripts/fetch-exiftool.mjs && node scripts/collect-licenses.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  }
}
